@prefix : <http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/> .

<http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#ecologicalInteraction
:ecologicalInteraction rdf:type owl:ObjectProperty ;
                       rdfs:domain :AlienLifeForm ;
                       rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#indigenousToPlanet
:indigenousToPlanet rdf:type owl:ObjectProperty ;
                    rdfs:domain :AlienLifeForm ;
                    rdfs:range :Planet ;
                    owl:propertyChainAxiom ( :livesIn
                                             :partOf
                                           ) .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedTo
:adaptedTo rdf:type owl:ObjectProperty ;
           rdfs:domain :AlienLifeForm ;
           rdfs:range :EnvironmentalCondition ;
           owl:propertyChainAxiom ( :adaptedToProfile
                                    :profileHasCondition
                                  ) .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedToProfile
:adaptedToProfile rdf:type owl:ObjectProperty ;
                  rdfs:domain :AlienLifeForm ;
                  rdfs:range :EnvironmentalProfile .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/commensalWith
:commensalWith rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :symbioticWith ;
               rdfs:domain :AlienLifeForm ;
               rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/competesWith
:competesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :AlienLifeForm ;
              rdfs:range :AlienLifeForm ;
              owl:propertyChainAxiom ( :predatorOf
                                       :preyOf
                                     ) .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/connectedTo
:connectedTo rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain :Environment ;
             rdfs:range :Environment .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumedBy
:consumedBy rdf:type owl:ObjectProperty ;
            owl:inverseOf :consumes .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumes
:consumes rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :ecologicalInteraction ;
          rdf:type owl:AsymmetricProperty ;
          rdfs:domain :AlienLifeForm ;
          rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/dependsOn
:dependsOn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :ecologicalInteraction ;
           rdfs:domain :AlienLifeForm ;
           rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicallyCompatibleWith
:ecologicallyCompatibleWith rdf:type owl:ObjectProperty ;
                            rdfs:domain :AlienLifeForm ;
                            rdfs:range :Environment .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/feedsOn
:feedsOn rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :consumes ;
         rdf:type owl:AsymmetricProperty ;
         rdfs:domain :AlienLifeForm ;
         rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :Environment ;
              rdfs:range :EnvironmentalCondition ;
              owl:propertyChainAxiom ( :hasProfile
                                       :profileHasCondition
                                     ) .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasDiet
:hasDiet rdf:type owl:ObjectProperty ;
         rdfs:domain :Fauna ;
         rdfs:range :DietType .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasEcologicalRole
:hasEcologicalRole rdf:type owl:ObjectProperty ;
                   rdfs:domain :AlienLifeForm ;
                   rdfs:range :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasProfile
:hasProfile rdf:type owl:ObjectProperty ;
            rdfs:domain :Environment ;
            rdfs:range :EnvironmentalProfile .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasResource
:hasResource rdf:type owl:ObjectProperty ;
             owl:inverseOf :resourceFoundIn .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasTrait
:hasTrait rdf:type owl:ObjectProperty ;
          rdfs:domain :AlienLifeForm ;
          rdfs:range :Trait .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/inhabitedBy
:inhabitedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :livesIn .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/inhabitsMedium
:inhabitsMedium rdf:type owl:ObjectProperty ;
                rdfs:domain :AlienLifeForm ;
                rdfs:range :HabitatMedium .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/livesIn
:livesIn rdf:type owl:ObjectProperty ;
         rdfs:domain :AlienLifeForm ;
         rdfs:range :Biome .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/mutualisticWith
:mutualisticWith rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :symbioticWith ;
                 rdf:type owl:SymmetricProperty ;
                 rdfs:domain :AlienLifeForm ;
                 rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/occupiesTrophicLevel
:occupiesTrophicLevel rdf:type owl:ObjectProperty ;
                      rdfs:domain :AlienLifeForm ;
                      rdfs:range :TrophicLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/parasiticWith
:parasiticWith rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :symbioticWith ;
               rdfs:domain :AlienLifeForm ;
               rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/partOf
:partOf rdf:type owl:ObjectProperty ;
        rdfs:domain :Environment ;
        rdfs:range :Planet .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/predatorOf
:predatorOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :feedsOn ;
            owl:inverseOf :preyOf ;
            rdf:type owl:AsymmetricProperty ;
            rdfs:domain :AlienLifeForm ;
            rdfs:range :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/preyOf
:preyOf rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :consumedBy .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/producesResource
:producesResource rdf:type owl:ObjectProperty ;
                  rdfs:domain :AlienLifeForm ;
                  rdfs:range :Resource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/profileHasCondition
:profileHasCondition rdf:type owl:ObjectProperty ;
                     rdfs:domain :EnvironmentalProfile ;
                     rdfs:range :EnvironmentalCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/resourceFoundIn
:resourceFoundIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :Resource ;
                 rdfs:range :Environment .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/structureLocatedIn
:structureLocatedIn rdf:type owl:ObjectProperty ;
                    rdfs:domain :ArtificialStructure ;
                    rdfs:range :Environment .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/symbioticWith
:symbioticWith rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :ecologicalInteraction ;
               rdf:type owl:SymmetricProperty ;
               rdfs:domain :AlienLifeForm ;
               rdfs:range :AlienLifeForm .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienBase
:AlienBase rdf:type owl:Class ;
           rdfs:subClassOf :ArtificialStructure .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm
:AlienLifeForm rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ArtificialStructure
:ArtificialStructure rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Biome
:Biome rdf:type owl:Class ;
       rdfs:subClassOf :Environment .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/CaveBiome
:CaveBiome rdf:type owl:Class ;
           rdfs:subClassOf :Biome .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/CaveStructure
:CaveStructure rdf:type owl:Class ;
               rdfs:subClassOf :Environment .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/CompatibleOrganism
:CompatibleOrganism rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :AlienLifeForm
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :ecologicallyCompatibleWith ;
                                                                 owl:someValuesFrom :Environment
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Coral
:Coral rdf:type owl:Class ;
       rdfs:subClassOf :SessileOrganism .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/DietType
:DietType rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EcologicalRole
:EcologicalRole rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment
:Environment rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalCondition
:EnvironmentalCondition rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalProfile
:EnvironmentalProfile rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Fauna
:Fauna rdf:type owl:Class ;
       rdfs:subClassOf :AlienLifeForm ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDiet ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :DietType
                       ] .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Flora
:Flora rdf:type owl:Class ;
       rdfs:subClassOf :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/HabitatMedium
:HabitatMedium rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Leviathan
:Leviathan rdf:type owl:Class ;
           rdfs:subClassOf :Fauna .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/LightCondition
:LightCondition rdf:type owl:Class ;
                rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/MineralResource
:MineralResource rdf:type owl:Class ;
                 rdfs:subClassOf :Resource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/OceanBiome
:OceanBiome rdf:type owl:Class ;
            rdfs:subClassOf :Biome .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/OrganicResource
:OrganicResource rdf:type owl:Class ;
                 rdfs:subClassOf :Resource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Planet
:Planet rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/PressureCondition
:PressureCondition rdf:type owl:Class ;
                   rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Resource
:Resource rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/SessileOrganism
:SessileOrganism rdf:type owl:Class ;
                 rdfs:subClassOf :AlienLifeForm .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/SurfaceBiome
:SurfaceBiome rdf:type owl:Class ;
              rdfs:subClassOf :Biome .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/TemperatureCondition
:TemperatureCondition rdf:type owl:Class ;
                      rdfs:subClassOf :EnvironmentalCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Trait
:Trait rdf:type owl:Class .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/TrophicLevel
:TrophicLevel rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Ameboid
:Ameboid rdf:type owl:NamedIndividual ,
                  :SessileOrganism ;
         :adaptedToProfile :DeepSeaProfile ;
         :hasEcologicalRole :Dentritivore ;
         :livesIn :LostRiver ;
         :occupiesTrophicLevel :DecomposerLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#BulbZone
:BulbZone rdf:type owl:NamedIndividual ,
                   :OceanBiome ;
          :hasProfile :DeepSeaProfile .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Copper
:Copper rdf:type owl:NamedIndividual ,
                 :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Dentritivore
:Dentritivore rdf:type owl:NamedIndividual ,
                       :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Diamond
:Diamond rdf:type owl:NamedIndividual ,
                  :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#GelSack
:GelSack rdf:type owl:NamedIndividual ,
                  :Flora ;
         :adaptedToProfile :DeepSeaProfile ;
         :hasEcologicalRole :PrimaryProducer ;
         :hasTrait :Photosythetic ;
         :inhabitsMedium :Aquatic ;
         :livesIn :BloodKelpZone ,
                  :LostRiver ;
         :occupiesTrophicLevel :Producer ;
         :producesResource :NaturalGel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#GhostWeed
:GhostWeed rdf:type owl:NamedIndividual ,
                    :Flora ;
           :hasEcologicalRole :PrimaryProducer ;
           :livesIn :BulbZone ,
                    :BloodKelpZone ,
                    :LostRiver ;
           :occupiesTrophicLevel :Producer .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Gold
:Gold rdf:type owl:NamedIndividual ,
               :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Lead
:Lead rdf:type owl:NamedIndividual ,
               :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Lithium
:Lithium rdf:type owl:NamedIndividual ,
                  :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Magntite
:Magntite rdf:type owl:NamedIndividual ,
                   :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#NaturalGel
:NaturalGel rdf:type owl:NamedIndividual ,
                     :OrganicResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Nickel
:Nickel rdf:type owl:NamedIndividual ,
                 :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Photosythetic
:Photosythetic rdf:type owl:NamedIndividual ,
                        :Trait .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Quartz
:Quartz rdf:type owl:NamedIndividual ,
                 :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Ruby
:Ruby rdf:type owl:NamedIndividual ,
               :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#SilverOre
:SilverOre rdf:type owl:NamedIndividual ,
                    :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Titanium
:Titanium rdf:type owl:NamedIndividual ,
                   :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#Uranite
:Uranite rdf:type owl:NamedIndividual ,
                  :MineralResource .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#4645B
<http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#4645B> rdf:type owl:NamedIndividual ,
                                                                                                  :Planet .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Amphibious
:Amphibious rdf:type owl:NamedIndividual ,
                     :HabitatMedium .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ApexPredator
:ApexPredator rdf:type owl:NamedIndividual ,
                       :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Aquatic
:Aquatic rdf:type owl:NamedIndividual ,
                  :HabitatMedium .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ArcticProfile
:ArcticProfile rdf:type owl:NamedIndividual ,
                        :EnvironmentalProfile ;
               :profileHasCondition :ExtremeCold .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Bioluminescent
:Bioluminescent rdf:type owl:NamedIndividual ,
                         :Trait .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/BloodKelpZone
:BloodKelpZone rdf:type owl:NamedIndividual ,
                        :OceanBiome ;
               :hasProfile :DeepSeaProfile .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Carnivore
:Carnivore rdf:type owl:NamedIndividual ,
                    :DietType .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Decomposer
:Decomposer rdf:type owl:NamedIndividual ,
                     :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/DecomposerLevel
:DecomposerLevel rdf:type owl:NamedIndividual ,
                          :TrophicLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/DeepSeaProfile
:DeepSeaProfile rdf:type owl:NamedIndividual ,
                         :EnvironmentalProfile ;
                :profileHasCondition :HighPressure ,
                                     :LowLight .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ExtremeCold
:ExtremeCold rdf:type owl:NamedIndividual ,
                      :TemperatureCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/FilterFeeder
:FilterFeeder rdf:type owl:NamedIndividual ,
                       :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/GhostLeviathan
:GhostLeviathan rdf:type owl:NamedIndividual ,
                         :Fauna ;
                :adaptedToProfile :DeepSeaProfile ;
                :hasDiet :Carnivore ;
                :hasEcologicalRole :ApexPredator ;
                :inhabitsMedium :Aquatic ;
                :livesIn :LostRiver ;
                :occupiesTrophicLevel :TertiaryConsumer ;
                :predatorOf :Ghostray ,
                            :RiverProwler .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Ghostray
:Ghostray rdf:type owl:NamedIndividual ,
                   :Fauna ;
          :adaptedToProfile :DeepSeaProfile ;
          :hasDiet :Herbivore ;
          :hasTrait :Bioluminescent ;
          :inhabitsMedium :Aquatic ;
          :livesIn :LostRiver .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Herbivore
:Herbivore rdf:type owl:NamedIndividual ,
                    :DietType .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/HighPressure
:HighPressure rdf:type owl:NamedIndividual ,
                       :PressureCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/HighTemperature
:HighTemperature rdf:type owl:NamedIndividual ,
                          :TemperatureCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/IceSurface
:IceSurface rdf:type owl:NamedIndividual ,
                     :HabitatMedium .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/LavaLake
:LavaLake rdf:type owl:NamedIndividual ,
                   :CaveBiome ;
          :hasProfile :DeepSeaProfile ,
                      :ThermalProfile .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/LightExposure
:LightExposure rdf:type owl:NamedIndividual ,
                        :LightCondition .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/LostRiver
:LostRiver rdf:type owl:NamedIndividual ,
                    :CaveBiome ;
           :hasProfile :DeepSeaProfile ;
           :hasResource :Lithium ,
                        :Magntite ,
                        :Ruby .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/LowLight
:LowLight rdf:type owl:NamedIndividual ,
                   :LightCondition .


