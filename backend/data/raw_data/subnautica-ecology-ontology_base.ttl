:Omnivore rdf:type owl:NamedIndividual ,
                   :DietType .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/PrimaryConsumer
:PrimaryConsumer rdf:type owl:NamedIndividual ,
                          :TrophicLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/PrimaryProducer
:PrimaryProducer rdf:type owl:NamedIndividual ,
                          :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Producer
:Producer rdf:type owl:NamedIndividual ,
                   :TrophicLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/RiverProwler
:RiverProwler rdf:type owl:NamedIndividual ,
                       :Fauna ;
              :adaptedToProfile :DeepSeaProfile ;
              :hasDiet :Carnivore ;
              :inhabitsMedium :Aquatic ;
              :livesIn :LostRiver .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Scavenger
:Scavenger rdf:type owl:NamedIndividual ,
                    :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/SecondaryConsumer
:SecondaryConsumer rdf:type owl:NamedIndividual ,
                            :TrophicLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ShallowSurfaceProfile
:ShallowSurfaceProfile rdf:type owl:NamedIndividual ,
                                :EnvironmentalProfile ;
                       :profileHasCondition :LightExposure .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/SimplePredator
:SimplePredator rdf:type owl:NamedIndividual ,
                         :EcologicalRole .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Terrestrial
:Terrestrial rdf:type owl:NamedIndividual ,
                      :HabitatMedium .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/TertiaryConsumer
:TertiaryConsumer rdf:type owl:NamedIndividual ,
                           :TrophicLevel .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ThermalProfile
:ThermalProfile rdf:type owl:NamedIndividual ,
                         :EnvironmentalProfile ;
                :profileHasCondition :HighTemperature .


###  http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Venomous
:Venomous rdf:type owl:NamedIndividual ,
                   :Trait .


