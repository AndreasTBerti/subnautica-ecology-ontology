<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/"
     xml:base="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#carriesMicroorganism -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#carriesMicroorganism">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Microorganism"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#infectedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#infectedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#infects"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#infects -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology#infects">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Microorganism"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalCondition"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedToProfile"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/profileHasCondition"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedToProfile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/adaptedToProfile">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalProfile"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/commensalWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/commensalWith">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/symbioticWith"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/competesWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/competesWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/predatorOf"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/preyOf"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/connectedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/connectedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumes"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumes">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicalInteraction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/dependsOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/dependsOn">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicalInteraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicalInteraction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicalInteraction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicallyCompatibleWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicallyCompatibleWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/feedsOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/feedsOn">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasCondition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalCondition"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasProfile"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/profileHasCondition"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasDiet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasDiet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Fauna"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/DietType"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasEcologicalRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasEcologicalRole">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EcologicalRole"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasProfile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasProfile">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalProfile"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasResource -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasResource">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/resourceFoundIn"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasTrait -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/hasTrait">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Trait"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/indigenousToPlanet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/indigenousToPlanet">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Planet"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/livesIn"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/partOf"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/inhabitedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/inhabitedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/livesIn"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/inhabitsMedium -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/inhabitsMedium">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/HabitatMedium"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/livesIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/livesIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Biome"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/mutualisticWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/mutualisticWith">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/symbioticWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/occupiesTrophicLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/occupiesTrophicLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/TrophicLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/parasiticWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/parasiticWith">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/symbioticWith"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/partOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/partOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Planet"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/predatorOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/predatorOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/feedsOn"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/preyOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/preyOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/preyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/consumedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/producesResource -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/producesResource">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/profileHasCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/profileHasCondition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalProfile"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/EnvironmentalCondition"/>
