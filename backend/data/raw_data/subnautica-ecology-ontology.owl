    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/resourceFoundIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/resourceFoundIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Resource"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/structureLocatedIn -->

