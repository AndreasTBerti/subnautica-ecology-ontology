                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/AlienLifeForm"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/ecologicallyCompatibleWith"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/andreas/ontologies/2026/4/subnautica-ecology-ontology/Environment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
